{
  "format": "dotobe-theme",
  "version": 1,
  "id": "kawaii-cafe",
  "name": "莓好咖啡屋",
  "author": "",
  "mode": "light",
  "swatches": [
    "#fff5eb",
    "#ffb7c5",
    "#a8e6cf",
    "#b04a68",
    "#6d4c41"
  ],
  "tokens": {
    "--rice": "#fff5eb",
    "--sky": "#b04a68",
    "--mint": "#a8e6cf",
    "--pink": "#ffb7c5",
    "--powder": "#cdb9e0",
    "--text": "#6d4c41",
    "--text-2": "#7b5c50",
    "--text-3": "#a1887f",
    "--border": "#e2d4c4",
    "--faint-bg": "#f8efe2",
    "--ok": "#2f7d5f",
    "--warn": "#9a6712",
    "--danger": "#c73e4d",
    "--info": "#4d7195",
    "--sky-t": "rgba(176, 74, 104, 0.10)",
    "--mint-t": "rgba(168, 230, 207, 0.20)",
    "--pink-t": "rgba(255, 183, 197, 0.22)",
    "--powder-t": "rgba(205, 185, 224, 0.20)",
    "--warn-t": "rgba(154, 103, 18, 0.10)",
    "--danger-t": "rgba(199, 62, 77, 0.09)",
    "--ok-t": "rgba(47, 125, 95, 0.10)",
    "--r-card": "1.25rem",
    "--r-lg": "1rem",
    "--r-md": "0.75rem",
    "--hairline": "1px solid rgba(109, 76, 65, 0.24)",
    "--hairline-soft": "1px solid rgba(109, 76, 65, 0.15)",
    "--shadow-hover": "0 2px 8px rgba(109, 76, 65, 0.08)",
    "--wa-shu": "#c0566b",
    "--fs-hero": "2.5rem",
    "--fs-h2": "1.5rem",
    "--font": "\"M PLUS Rounded 1c\",\"YouYuan\",\"Microsoft YaHei UI\",sans-serif"
  },
  "css": "@font-face{font-family:\"M PLUS Rounded 1c\";font-style:normal;font-weight:300;font-display:swap;src:url(\"data:font/woff2;base64,\") format(\"woff2\");}\n@font-face{font-family:\"ZCOOL QingKe HuangYou\";font-style:normal;font-weight:400;font-display:swap;src:url(\"data:font/woff2;base64,\") format(\"woff2\");}\nh1,h2,.stat .value,.topbar .title,.logo,.auth-brand .logo{font-family:\"ZCOOL QingKe HuangYou\",\"M PLUS Rounded 1c\",\"Microsoft YaHei UI\",sans-serif;letter-spacing:.05em;}\n.content .card{position:relative;z-index:1}\nhtml{background:var(--rice)}\nbody{background:transparent}\n.dash-greet{padding-right:200px}\n.dash-greet::after{content:\"\";position:absolute;top:-12px;right:6px;width:164px;height:158px;border-radius:60% 40% 55% 45%;border:1px solid var(--hairline);transform:rotate(-2deg);background:url(\"data:image/jpeg;base64,\") center 30%/cover no-repeat;pointer-events:none}\n.dash-greet::before{content:\"\";position:absolute;right:-14px;bottom:-22px;width:132px;height:132px;background:var(--pink-t);border-radius:45% 55% 40% 60%;pointer-events:none}\n@media (max-width:1100px){.dash-greet{padding-right:0}.dash-greet::after,.dash-greet::before{display:none}}\n.auth-page::after{content:\"\";position:fixed;right:7vw;bottom:9vh;width:226px;height:217px;z-index:0;pointer-events:none;border-radius:60% 40% 55% 45%;border:1px solid var(--hairline);transform:rotate(-2deg);background:url(\"data:image/jpeg;base64,\") center 30%/cover no-repeat}\n@media (max-height:740px),(max-width:1100px){.auth-page::after{display:none}}\n.wa-wash{background:radial-gradient(circle at 42% 42%,rgba(255,142,168,.16) 0%,rgba(255,142,168,.06) 42%,rgba(255,142,168,0) 72%)}\n.botanical path,.botanical line,.botanical circle{stroke:#e58ba0}\nbody::before{background:repeating-linear-gradient(0deg,transparent 0 2px,rgba(255,163,183,.045) 2px 3px),repeating-linear-gradient(90deg,transparent 0 2px,rgba(255,163,183,.04) 2px 3px)}\n.btn.primary:hover{box-shadow:0 2px 10px rgba(176,74,104,.22)}\n",
  "decor": [
    "petals"
  ]
}